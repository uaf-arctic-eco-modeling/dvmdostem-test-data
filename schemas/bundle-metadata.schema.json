{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uaf-arctic-eco-modeling/dvmdostem-test-data/blob/main/schemas/bundle-metadata.schema.json",
  "title": "dvm-dos-tem standard test-data bundle metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owners",
    "bundle",
    "file_inventory",
    "provenance",
    "redistribution",
    "generation",
    "intended_scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_maintainer"
      ],
      "properties": {
        "data_maintainer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_version",
        "asset_name",
        "format",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "release_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "asset_name": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "file_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_description",
        "source_identifiers"
      ],
      "properties": {
        "source_description": {
          "type": "string",
          "minLength": 1
        },
        "source_identifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "redistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "license_or_terms"
      ],
      "properties": {
        "status": {
          "enum": [
            "provisional",
            "internal-only",
            "permitted"
          ]
        },
        "license_or_terms": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure",
        "generator_revision"
      ],
      "properties": {
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "generator_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intended_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "expected_behavior"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "expected_behavior": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
